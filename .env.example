# DealWatch Bot Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated list of chat IDs to send notifications to
# Get these by messaging your bot and checking /whoami or getChatId
BOT_CHAT_IDS=

# Google Sheets URL (read-only access required)
SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Optional: Filter by specific plate numbers (comma-separated)
# PLATES=629,718,715,058,124

# Optional: Filter by cities (comma-separated)
# CITIES=Набережные Челны,Москва
